# ==============================================================================
# AmbiVision — Production & Staging Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel, VPS, AWS), configure these in your deployment settings.

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://ambivision.in
NEXT_PUBLIC_GSC_VERIFICATION=

# ------------------------------------------------------------------------------
# Email Delivery Configuration (Option A: Resend — Recommended)
# ------------------------------------------------------------------------------
# 1. Sign up at https://resend.com and obtain an API key.
# 2. Verify your domain (ambivision.in) with SPF, DKIM, and DMARC DNS records.
# 3. Set EMAIL_FROM to an address on your verified domain (e.g., inquiry@ambivision.in).
# For initial testing before domain verification, you may use onboarding@resend.dev.
RESEND_API_KEY=
EMAIL_FROM=AmbiVision Inquiries <inquiry@ambivision.in>

# ------------------------------------------------------------------------------
# Email Delivery Configuration (Option B: Standard SMTP — Fallback)
# ------------------------------------------------------------------------------
# If not using Resend, provide your SMTP server credentials:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# Notification Target (Where inquiries and job applications are sent)
# ------------------------------------------------------------------------------
CONTACT_EMAIL_TO=prernapawar1618@ambivision.in
CAREERS_EMAIL_TO=prernapawar1618@ambivision.in
